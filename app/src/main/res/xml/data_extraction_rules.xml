<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份/迁移规则。菜谱数据是用户创作，随备份走；
     DataStore 里存的是显示偏好，一并带上。 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
        <include domain="file" path="covers" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
        <include domain="file" path="covers" />
    </device-transfer>
</data-extraction-rules>
